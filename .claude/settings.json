{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-rebuild.sh",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(just check)",
            "Bash(just eval)",
            "Bash(just fmt)",
            "Bash(just fmt-check)",
            "Bash(just diff)",
            "Bash(nix search:*)",
            "Bash(nix flake check)",
            "Bash(nix flake show:*)",
            "Bash(nixfmt:*)",
            "Bash(nvd diff:*)"
        ],
        "ask": [
            "Bash(just rebuild:*)",
            "Bash(just update:*)",
            "Bash(just rollback:*)",
            "Bash(nh darwin switch:*)",
            "Bash(nh os switch:*)",
            "Bash(darwin-rebuild switch:*)",
            "Bash(sudo darwin-rebuild switch:*)",
            "Bash(nixos-rebuild switch:*)",
            "Bash(sudo nixos-rebuild switch:*)",
            "Bash(topgrade:*)"
        ]
    }
}
