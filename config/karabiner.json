{
    "global": {
        "show_in_menu_bar": false
    },
    "profiles": [
        {
            "name": "Default",
            "selected": true,
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps Lock → Escape (tap) / Control (hold)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_control",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [
                                    {
                                        "key_code": "escape"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Left Control → Hyper (Ctrl+Shift+Alt+Cmd)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "left_control",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": [
                                            "left_control",
                                            "left_option",
                                            "left_command"
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Hyper+E → focus or open an Emacs frame; Hyper+C → org-capture popup (init.el)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "e",
                                    "modifiers": {
                                        "mandatory": [
                                            "command",
                                            "control",
                                            "option",
                                            "shift"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "ec=/etc/profiles/per-user/tomrfitz/bin/emacsclient; [ \"$($ec -e '(tf/raise-frame)')\" = t ] || $ec -n -c -e '(tf/focus-new-frame)'"
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "c",
                                    "modifiers": {
                                        "mandatory": [
                                            "command",
                                            "control",
                                            "option",
                                            "shift"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "/etc/profiles/per-user/tomrfitz/bin/emacsclient -n -c -F '((name . \"org-capture\") (tf-popup . t) (fullscreen) (width . 100) (height . 20))' -e '(tf/popup-org-capture)'"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            "virtual_hid_keyboard": {
                "caps_lock_delay_milliseconds": 0,
                "keyboard_type_v2": "ansi"
            }
        }
    ]
}
